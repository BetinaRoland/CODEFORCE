#include <iostream>
using namespace std;
int main() 
{
    int t;
    cin >> t;
    while (t--) 
    {
        int n, x, c = 0;
        cin >> n;
        for (int i = 0; i < n; ++i) 
        {
            cin >> x;
            if (x == -1) 
            {
                c++;
            }
        }
        int o = 0;
        if (c > n - c) 
        {
            o = c - n / 2;
            c = n / 2;
        }
        if (c % 2) 
        {
            o++;
        }
        cout << o << "\n";
    }
}
